#!name=X 去广告（测试版）
#!desc=尝试过滤 X/Twitter 响应中的显式推广内容；未实机验证，可能漏过滤或影响部分内容。
#!author=ChatGPT

[Script]
http-response ^https?:\/\/(?:api\.)?(?:x\.com|twitter\.com)\/i\/api\/graphql\/ script-path=https://raw.githubusercontent.com/YOUR_USERNAME/YOUR_REPO/main/x_remove_ads.js,timeout=20,requires-body=true,tag=X去广告-测试版,enable=true

[MITM]
hostname = %APPEND% x.com, *.x.com, twitter.com, *.twitter.com
