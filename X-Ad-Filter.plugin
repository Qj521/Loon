#!name=X 信息流去广告（测试版）
#!desc=尝试移除 X/Twitter GraphQL 时间线中带推广元数据的推文；未经实机验证。
#!author=ChatGPT

[Script]
http-response ^https?:\/\/(?:api\.)?(?:x\.com|twitter\.com)\/i\/api\/graphql\/ script-path=https://raw.githubusercontent.com/Qj521/Loon/main/x_remove_ads.js,timeout=20,requires-body=true,tag=X信息流去广告,enable=true

[MITM]
hostname = %APPEND% x.com, *.x.com, twitter.com, *.twitter.com
